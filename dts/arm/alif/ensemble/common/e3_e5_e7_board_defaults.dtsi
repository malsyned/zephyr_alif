&i2s3 {
	pinctrl-0 = <&pinctrl_i2s3>;
	pinctrl-1 = <&pinctrl_i2s3_sleep>;
	pinctrl-names = "default", "sleep";
};

&cam {
	pinctrl-0 = <&pinctrl_cam8>;
	pinctrl-names = "default";
};

&ospi1 {
	pinctrl-0 = <&pinctrl_ospi1>;
	pinctrl-names = "default";
};
